<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <ImageView
        android:id="@+id/ivReceta"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:background="@color/black"/>


    <ImageButton
        android:id="@+id/btnFavorito"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/btn_star_big_off"
        app:tint="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="8dp"
        />


    <TextView
        android:id="@+id/tvNombreReceta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Nombre de la receta"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvTipoReceta"
        app:layout_constraintEnd_toStartOf="@+id/btnFavorito"
        app:layout_constraintStart_toEndOf="@+id/ivReceta"
        app:layout_constraintTop_toTopOf="@+id/ivReceta"
        app:layout_constraintVertical_chainStyle="packed"/>


    <TextView
        android:id="@+id/tvTipoReceta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Tipo:"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/tvOrigenReceta"
        app:layout_constraintEnd_toStartOf="@+id/btnFavorito"
        app:layout_constraintStart_toEndOf="@+id/ivReceta"
        app:layout_constraintTop_toBottomOf="@+id/tvNombreReceta"
        app:layout_constraintVertical_chainStyle="packed"/>


    <TextView
        android:id="@+id/tvOrigenReceta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Origen:"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/ivReceta"
        app:layout_constraintEnd_toStartOf="@+id/btnFavorito"
        app:layout_constraintStart_toEndOf="@+id/ivReceta"
        app:layout_constraintTop_toBottomOf="@+id/tvTipoReceta"
        app:layout_constraintVertical_bias="1.0" />

</androidx.constraintlayout.widget.ConstraintLayout>
