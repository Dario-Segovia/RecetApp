<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.santosgo.recetapp.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_noticeFragment5"
            app:destination="@id/noticeFragment5" />
    </fragment>
    <fragment
        android:id="@+id/noticeFragment5"
        android:name="com.santosgo.recetapp.NoticeFragment"
        android:label="fragment_notice"
        tools:layout="@layout/fragment_notice" >
        <action
            android:id="@+id/action_noticeFragment5_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_noticeFragment5_to_principalFragment"
            app:destination="@id/principalFragment" />
    </fragment>

    <action
        android:id="@+id/action_tab2NoticeFragment_to_loginFragment"
        app:destination="@id/loginFragment" />
    <fragment
        android:id="@+id/principalFragment"
        android:name="com.santosgo.recetapp.PrincipalFragment"
        android:label="fragment_principal"
        tools:layout="@layout/fragment_principal">
        <action
            android:id="@+id/action_favoriteFragment_to_detailFavItemFragment22"
            app:destination="@id/detailFavItemFragment2" />

    </fragment>


    <fragment
        android:id="@+id/detailFavItemFragment2"
        android:name="com.santosgo.recetapp.DetailFavItemFragment"
        android:label="DetailFavItemFragment" >
        <action
            android:id="@+id/action_detailFavItemFragment2_to_principalFragment"
            app:destination="@id/principalFragment"
            app:popUpTo="@id/principalFragment" />
    </fragment>


</navigation>