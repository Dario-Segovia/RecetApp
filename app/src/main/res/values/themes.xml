<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RecetApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Personaliza los colores -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Colores del fondo y texto -->
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:textColorPrimary">@color/textColorPrimary</item>
        <item name="android:textColorSecondary">@color/textColorSecondary</item>

        <!-- Colores de botones -->
        <item name="colorButtonNormal">@color/buttonBackgroundColor</item>
    </style>

    <style name="Theme.RecetApp" parent="Base.Theme.RecetApp" />
    
    <style name="SplashTheme" parent="Theme.AppCompat.DayNight">
        <item name="actionBarItemBackground">@drawable/logococina</item>
    </style>
</resources>